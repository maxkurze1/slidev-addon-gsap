{
  "name": "slidev-addon-gsap",
  "version": "0.0.0",
  "type": "module",
  "description": "Integrate GSAP animations into SliDev",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@10.33.2",
  "exports": {
    ".": "./index.ts",
    "./*": "./*"
  },
  "keywords": [
    "slidev-addon",
    "slidev",
    "GSAP"
  ],
  "homepage": "https://maxkurze1.github.io/slidev-addon-gsap/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxkurze1/slidev-addon-gsap.git"
  },
  "bugs": {
    "url": "https://github.com/maxkurze1/slidev-addon-gsap/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "global-bottom.vue",
    "scripts",
    "styles",
    "skills",
    "README.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "slidev build example.mdc",
    "dev": "slidev example.mdc --remote",
    "export": "slidev export example.mdc",
    "screenshot": "slidev export example.mdc --format png",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@slidev/client": "^52.15.0",
    "@slidev/types": "^52.15.0",
    "gsap": "^3.15.0",
    "two.js": "^0.8.23"
  },
  "devDependencies": {
    "@slidev/cli": "^52.15.0",
    "@slidev/theme-default": "^0.25.0",
    "vitepress": "^1.6.4"
  }
}
